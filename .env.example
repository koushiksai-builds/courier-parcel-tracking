# Copy to .env and replace the example values. Never commit .env.
# Render reads these from its Environment tab instead of a .env file.

# --- MySQL (Aiven free tier) ---
# Aiven dashboard -> your MySQL service -> Overview -> Parameters
DB_HOST=your-service-name.aivencloud.com
DB_PORT=25827
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace-with-aiven-password
DB_SSL_MODE=REQUIRED

# --- RabbitMQ (CloudAMQP free "Little Lemur" plan) ---
# CloudAMQP dashboard -> your instance -> "AMQP" connection parameters
RABBIT_HOST=your-instance.lmq.cloudamqp.com
RABBIT_PORT=5671
RABBIT_USERNAME=your-user
RABBIT_PASSWORD=replace-with-password
RABBIT_VHOST=your-vhost
RABBIT_SSL_ENABLED=true

# --- App login ---
ADMIN_EMAIL=admin@courier.local
ADMIN_PASSWORD=choose-a-strong-password

# --- Public URL of the frontend (your Vercel address) ---
PUBLIC_BASE_URL=https://your-app.vercel.app

# --- Optional: email notifications (SendGrid over HTTPS; Render free blocks SMTP) ---
MAIL_ENABLED=false
MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME=Courier Parcel Tracking
MAIL_RETRY_INTERVAL_MS=60000
MAIL_MAX_ATTEMPTS=8

# SendGrid dashboard -> Settings -> API Keys -> create a "Mail Send" key
SENDGRID_API_KEY=replace-with-sendgrid-key

# Inbox that receives support form submissions
SUPPORT_EMAIL=your-address@gmail.com

# Demo checkout amount in INR
PAYMENT_DEMO_AMOUNT=100.00
