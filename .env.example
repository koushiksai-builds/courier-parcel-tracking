# Copy to .env and replace the example values. Never commit .env.
# Gmail SMTP normally requires a Google App Password, not your account password.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=replace-with-your-google-app-password
MAIL_FROM=your-sender@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_RETRY_INTERVAL_MS=60000
MAIL_MAX_ATTEMPTS=8

# Inbox that receives support form submissions
SUPPORT_EMAIL=koushiksai1182004@gmail.com
